# Postgres connection string (Neon in production). Leave empty locally to use the built-in PGlite database in .data/
DATABASE_URL=

# Public URL of the app, used in emailed links. Optional locally.
APP_URL=http://localhost:3005

# Email via Resend. Without a key, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM="School OS <no-reply@adalintech.com>"

# Image storage (school logos, photos). Without these, uploads are saved to .data/uploads locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Private documents (homework, lesson notes) in Cloudflare R2. Without these, files are saved to .data/files locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
