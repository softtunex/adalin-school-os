# Copy to .env.local for local work. Locally, everything works with this file as it is: the
# database, files and email all run on your machine. On the live site (Vercel), set the ones
# marked REQUIRED; the app refuses to start without them (see docs/operations.md).

# ---------- Core ----------
# Postgres connection string (Neon). REQUIRED live. Leave empty locally to use the built-in database in .data/.
DATABASE_URL=
# Public address of the app, used in emailed links and redirects. REQUIRED live, https.
APP_URL=http://localhost:3005
# Protects the scheduled jobs (/api/cron/*). REQUIRED live: a long random string.
CRON_SECRET=
# Secret mixed into one-time sign-in codes. REQUIRED live: a long random string.
SESSION_SECRET=

# ---------- Email (Resend) ----------
# Without a key, emails are printed to the server log.
RESEND_API_KEY=
MAIL_FROM="Adalin SchoolHub <no-reply@adalintech.com>"

# ---------- SMS (Termii) ----------
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=
TERMII_BASE_URL=

# ---------- Payments (Paystack) ----------
PAYSTACK_SECRET_KEY=
# Adalin's cut of online fee payments, in percent. 0 = nothing.
PAYSTACK_PLATFORM_PERCENT=0

# ---------- Files ----------
# Images (logos, photos, signatures). Without these, saved to .data/uploads locally.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Private documents (homework, lesson notes) in Cloudflare R2. Without these, saved to .data/files locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---------- Sign-in with Google and Microsoft (optional) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Custom domains (optional): connect schools' addresses automatically ----------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# ---------- Monitoring (optional but recommended live) ----------
# Errors go to Sentry when set.
SENTRY_DSN=
# Log school transactions slower than this many milliseconds.
SLOW_QUERY_MS=1000

# ---------- Test and demo servers only: NEVER on the live site ----------
# ALLOW_LOCAL_DB=1           # production build on the local database (CI, demos)
# ALLOW_TEST_LOGIN_CODES=1   # parent sign-in codes shown on screen
# PAYMENTS_TEST_MODE=1       # fake card checkout
